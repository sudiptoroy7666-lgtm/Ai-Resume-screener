<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:startColor="#B38B5CF6"
                android:centerColor="#66A78BFA"
                android:endColor="#1A6D28D9"
                android:angle="45"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape>
            <stroke
                android:width="1.5dp"
                android:color="#66FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>