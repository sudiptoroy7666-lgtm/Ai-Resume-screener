<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Source badge row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSourceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#E0F2FE"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="#0369A1"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="PERSONAL SCAN" />

            <TextView
                android:id="@+id/tvSourceDetail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                tools:text="Acme Corp — Senior Dev" />
        </LinearLayout>

        <!-- Top row: Score ring + File info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_width="52dp"
                android:layout_height="52dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/miniScoreRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:indeterminate="false"
                    app:indicatorColor="#0F766E"
                    app:indicatorSize="52dp"
                    app:trackColor="#F1F5F9"
                    app:trackThickness="5dp"
                    tools:progress="85" />

                <TextView
                    android:id="@+id/tvScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:textColor="#0F766E"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="85%" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Resume_JohnDoe.pdf" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    tools:text="Jul 08, 2026 14:30" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvScoreBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#D1FAE5"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#065F46"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Strong" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="#F1F5F9" />

        <TextView
            android:id="@+id/tvSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:maxLines="2"
            android:textColor="#475569"
            android:textSize="14sp"
            tools:text="Strong alignment with job requirements..." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:background="#0F766E" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp"
                android:text="Top Matched:"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvKeywords"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#0F766E"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Python, SQL, Git" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>