<resources>
    <style name="Theme.AiResumeScreener" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <!-- ✅ Bulletproof custom splash theme (no system splash) -->
    <style name="Theme.App.Starting" parent="Theme.MaterialComponents.Light.NoActionBar" xmlns:tools="http://schemas.android.com/tools">
        <!-- Immediately show a white background (same as your splash design) -->
        <item name="android:windowBackground">@color/white</item>
        <!-- Remove any title bar -->
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <!-- Prevent the system from drawing a default status bar background -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <!-- Do NOT inherit from Theme.SplashScreen -->
    </style>
</resources>