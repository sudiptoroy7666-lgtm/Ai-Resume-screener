<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AiResumeScreener" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Match the background to the XML layout -->
        <item name="windowSplashScreenBackground">@color/white</item>
        <!-- Use the round icon for a cleaner look -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/app_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.AiResumeScreener</item>
    </style>

</resources>